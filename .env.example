# For development and scripts: `ymcp --env .env <command>`.
# Normal installs store these with `ymcp auth` instead.

# Instance root, without /api
YOUTRACK_URL=https://youtrack.example.com
# YouTrack (Hub) account; LDAP accounts work too. 2FA is not supported.
YOUTRACK_LOGIN=
YOUTRACK_PASSWORD=
# Outbound proxy: empty = HTTP(S)_PROXY from env, "none" = direct, or a URL
YOUTRACK_PROXY=
